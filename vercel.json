{
  "buildCommand": "npm run build:shared && npm run build:client",
  "outputDirectory": "packages/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://gift-upgrader-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
