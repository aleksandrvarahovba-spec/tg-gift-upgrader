{
  "name": "nft-gift-upgrader-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build:shared",
    "vercel-build": "npm run build:shared && npm run build:client",
    "build:shared": "npm run build --workspace=@upgrader/shared",
    "build:server": "npm run build --workspace=@upgrader/server",
    "build:client": "npm run build --workspace=@upgrader/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "start": "npm run start --workspace=@upgrader/server",
    "start:server": "npm run start --workspace=@upgrader/server",
    "start:client": "npm run preview --workspace=@upgrader/client",
    "dev:server": "npm run dev --workspace=@upgrader/server",
    "dev:client": "npm run dev --workspace=@upgrader/client",
    "dev": "npm run dev:server",
    "db:push": "npm run db:push --workspace=@upgrader/server",
    "db:generate": "npm run db:generate --workspace=@upgrader/server",
    "db:seed": "npm run db:seed --workspace=@upgrader/server"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.6.3"
  }
}
